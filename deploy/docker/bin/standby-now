#!/bin/sh
# Loads the NEWEST R2 backup into the Neon standby now (without making a new backup), then checks the
# standby holds exactly that backup's rows. For the Console, e.g. after standby-clear, after fixing
# Neon, or to check the standby after setting it up. backup-now does the same after every backup.
set -eu
. /usr/local/bin/common.sh

need_env STANDBY_DATABASE_URL R2_BUCKET
use_r2
newest="$(rclone lsf --files-only "r2:$R2_BUCKET/daily/" | grep '\.dump\.gpg$' | sort | tail -n 1)" \
  || fail "Could not list the backups in R2 (check the R2 settings)."
[ -n "$newest" ] || fail "There are no backups in R2 daily/ yet. Run backup-now instead."

set +e
result="$(/usr/local/bin/standby-copy "daily/$newest" 2>&1)"
set -e
printf '%s\n' "$result" | grep -v '^STANDBY-' || true
case "$(printf '%s\n' "$result" | tail -n 1)" in
  STANDBY-OK) log "Standby is up to date with $newest." ;;
  *) fail "The standby is out of date: $(printf '%s\n' "$result" | sed -n 's/^STANDBY-FAILED: //p' | tail -n 1)." ;;
esac

#!/bin/sh
# Copies the database off the server: pg_dump (the app's schemas "public" and "drizzle") → locked
# with BACKUP_PASSPHRASE → this company's Cloudflare R2 bucket, daily/ (and monthly/ on the 1st).
# Runs on BACKUP_SCHEDULE (nightly 02:30 by default); type backup-now in the jobs Console to run it
# at once. The uptime monitor gets an ok ping when all went well, a fail ping with the reason if not.
set -eu
. /usr/local/bin/common.sh

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# Stop without a backup: tell the uptime monitor, then stop with the reason.
no_backup() {
  ping fail "No backup was saved: $1"
  fail "$1 No backup was saved."
}

need_env DATABASE_URL COMPANY_SLUG BACKUP_PASSPHRASE
use_r2

# An empty database (the setup screen not filled in yet, or a new server after a disaster before the
# restore) is never backed up: it would become the "newest" backup that restore picks.
logins="$(psql "$DATABASE_URL" -X -A -t -v ON_ERROR_STOP=1 -c 'select count(*) from profiles')" \
  || no_backup "The database could not be read."
if [ "$logins" = "0" ]; then
  log "No company yet (the setup screen hasn't been filled in, or the restore hasn't run): nothing to back up — skipped."
  exit 0
fi

# With seconds: a backup-now typed right after the scheduled one never replaces it.
name="sparepartslk-${COMPANY_SLUG}_$(colombo_stamp)$(date +%S).dump.gpg"

log "Backup: copying the database..."
pg_dump --format=custom --no-owner --no-acl --schema=public --schema=drizzle \
  --file="$work/db.dump" "$DATABASE_URL" \
  || no_backup "The database could not be copied."

printf '%s' "$BACKUP_PASSPHRASE" >"$work/pass"
gpg --batch --quiet --pinentry-mode loopback --passphrase-file "$work/pass" \
  --symmetric --cipher-algo AES256 --output "$work/$name" "$work/db.dump" \
  || { rm -f "$work/pass"; no_backup "The copy could not be locked (gpg)."; }
rm -f "$work/pass" "$work/db.dump"

rclone copyto "$work/$name" "r2:$R2_BUCKET/daily/$name" \
  || no_backup "The backup could not be sent to R2 (check the R2 settings and the internet)."
saved="daily/$name"
if [ "$(TZ=Asia/Colombo date +%d)" = "01" ]; then
  rclone copyto "$work/$name" "r2:$R2_BUCKET/monthly/$name" \
    || no_backup "The monthly copy could not be sent to R2 (the daily one was saved)."
  saved="$saved and monthly/$name"
fi
size="$(du -h "$work/$name" | cut -f1)"
log "R2 backup was saved: $saved ($size)"

# The standby copy: download it back, unlock, load into Neon, compare counts (standby-copy).
if [ -z "${STANDBY_DATABASE_URL:-}" ]; then
  log "Standby: off (no STANDBY_DATABASE_URL) — skipped"
elif [ "${STANDBY_SYNC:-on}" != "on" ]; then
  # Paused on purpose during a switch, but easy to forget afterwards: nag every backup until it is
  # back on, so the standby never goes stale unnoticed.
  log "Standby: paused (STANDBY_SYNC=${STANDBY_SYNC}) — skipped. Set STANDBY_SYNC=on once the shop is back on this server."
  ping fail "Backup saved ($saved), but standby PAUSED (STANDBY_SYNC=${STANDBY_SYNC}): it is not being updated"
  log "Finished (backup saved, standby paused)"
  exit 0
else
  set +e
  result="$(/usr/local/bin/standby-copy "daily/$name" 2>&1)"
  set -e
  printf '%s\n' "$result" | grep -v '^STANDBY-' || true
  case "$(printf '%s\n' "$result" | tail -n 1)" in
    STANDBY-OK) ;;
    *)
      reason="$(printf '%s\n' "$result" | sed -n 's/^STANDBY-FAILED: //p' | tail -n 1)"
      reason="${reason:-unknown problem}"
      ping fail "Backup saved, but standby out of date: $reason"
      fail "The R2 backup was saved ($saved), but the standby is out of date: $reason."
      ;;
  esac
fi

ping ok "Backup saved: $saved ($size)"
log "Finished OK"

#!/bin/sh
# Clears the "standby has been used" mark, so the next backup may overwrite the Neon standby again.
# ONLY after the standby's data is safe: the shop is back on this server and restore-from-standby
# has brought the data back — or after a fire drill (nothing real was done on the standby).
# Usage: standby-clear --yes
set -eu
. /usr/local/bin/common.sh

[ "${1:-}" = "--yes" ] || fail "Usage: standby-clear --yes   (only once the standby's data is safe — see the guide)"
need_env STANDBY_DATABASE_URL

was="$(psql "$STANDBY_DATABASE_URL" -X -A -t -v ON_ERROR_STOP=1 -c "
  select coalesce(to_char(used_at at time zone 'Asia/Colombo', 'YYYY-MM-DD HH24:MI'), 'not used')
  from standby_meta.sync")" || fail "Could not read the standby's state (has it ever been loaded?)."
psql "$STANDBY_DATABASE_URL" -X -q -v ON_ERROR_STOP=1 -c "update standby_meta.sync set used_at = null" \
  || fail "Could not clear the mark."
log "Standby mark cleared (it was: $was). The next backup will load the standby again."

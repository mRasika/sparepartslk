#!/bin/sh
# The standby half of the nightly chain (called by backup-now and standby-now):
#   download the backup BACK from R2 → unlock it → load it into the Neon standby → compare the row
#   counts, table by table, with the live database's counts taken at backup time.
# Downloading it back proves every night that R2, the file and the passphrase all work.
# Prints one last line "STANDBY-OK" or "STANDBY-FAILED: <reason>"; exit 0 / 1 (4 = standby used).
# Usage: standby-copy <daily/name.dump.gpg> <counts-file>
set -eu
. /usr/local/bin/common.sh

object="${1:?Usage: standby-copy <daily/name.dump.gpg> <counts-file>}"
counts="${2:?Usage: standby-copy <daily/name.dump.gpg> <counts-file>}"
need_env STANDBY_DATABASE_URL BACKUP_PASSPHRASE
use_r2

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
failed() { echo "STANDBY-FAILED: $1"; exit "${2:-1}"; }

log "Standby: downloading $object back from R2..."
file="$(fetch_backup "$object" "$work")" || failed "the backup could not be downloaded back from R2"

printf '%s' "$BACKUP_PASSPHRASE" >"$work/pass"
gpg --batch --quiet --pinentry-mode loopback --passphrase-file "$work/pass" \
  --output "$work/db.dump" --decrypt "$file" \
  || { rm -f "$work/pass"; failed "the backup downloaded from R2 could not be unlocked"; }
rm -f "$work/pass" "$file"

set +e
/usr/local/bin/standby-load "$work/db.dump"
code=$?
set -e
[ "$code" -eq 0 ] || {
  [ "$code" -eq 4 ] && failed "the standby has been used since the last copy (not overwritten)" 4
  failed "the standby could not be loaded (it keeps the previous copy)"
}

table_counts "$STANDBY_DATABASE_URL" >"$work/standby-counts" || failed "the standby could not be counted"
if ! diff "$counts" "$work/standby-counts" >"$work/diff"; then
  log "Rows differ (< live database at backup time, > standby):"
  sed 's/^/    /' "$work/diff"
  failed "the standby's rows differ from the live database's"
fi
log "Standby: same rows as the live database in all $(wc -l <"$counts" | tr -d ' ') tables."
echo "STANDBY-OK"

# Settings for ONE company's copy of Sparepartslk (docs/operations/docker-hosting.md).
#
# 1. Copy this file, fill it in on your own computer (never paste the values into a chat).
# 2. Portainer → Stacks → Add stack → "Load variables from .env file" → choose the filled-in file.
#
# Making a secret: on the server run   openssl rand -hex 32   and paste the result.
# Use a NEW secret for every line that asks for one, and for every company.
# Keep the filled-in file somewhere safe (a password manager): it is the key to this copy.

# --- Which version and which company ----------------------------------------------------------
# The release to run: the newest with a green tick in GitHub → Actions → Docker image.
# Change this and press "Update the stack" for a new version.
APP_VERSION=v1.0.0
# Short name for this company, used in backup file names (small letters, no spaces).
COMPANY_SLUG=newshop
# The database volume made once with: docker volume create sparepartslk-<slug>-pgdata
PGDATA_VOLUME=sparepartslk-newshop-pgdata

# --- The web address ---------------------------------------------------------------------------
# The address people open, with https:// and no slash at the end. The Vercel standby uses the same.
BETTER_AUTH_URL=https://shop.example.com

# --- Secrets (make each one with: openssl rand -hex 32) -----------------------------------------
# Signs login cookies. The Vercel standby project uses the SAME value (people stay signed in after
# a switch).
BETTER_AUTH_SECRET=
# The database password. Letters and numbers only (openssl rand -hex 32 is fine).
DB_PASSWORD=

# --- Cloudflare tunnel (HTTPS) ------------------------------------------------------------------
# Cloudflare → Zero Trust → Networks → Tunnels → this company's tunnel → the token.
TUNNEL_TOKEN=

# --- First start only: the one-time "Set up" screen ----------------------------------------------
# With an empty database the website shows the setup screen: business name and the owner's login.
# This key must be typed there, so nobody else can set it up first.
# Make it with: openssl rand -hex 24   — after the setup, empty this line and Update the stack.
SETUP_KEY=

# --- Nightly off-site backup (Cloudflare R2) ------------------------------------------------------
# The passphrase that locks every backup file. WITHOUT IT NO BACKUP CAN BE OPENED: keep a copy
# outside the server (password manager). Make it with: openssl rand -hex 32
BACKUP_PASSPHRASE=
# Cloudflare → R2: the account id, this company's own bucket, and an API key for that bucket only.
R2_ACCOUNT_ID=
R2_BUCKET=sparepartslk-newshop-backup
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# When the backup runs, in Sri Lanka time (cron: minute hour day month weekday). Nightly 02:30:
#   30 2 * * *
# Later, every 3 hours from 09:00 to 21:00 as well:   30 2,9,12,15,18,21 * * *
BACKUP_SCHEDULE=30 2 * * *

# --- Neon standby (a copy of the data outside this server, loaded after every backup) -------------
# Neon → this company's project → Connect → "Pooled connection" OFF (the direct address), with
# ?sslmode=require. Empty = no standby copy (the backup still runs).
STANDBY_DATABASE_URL=
# on = load every backup into the standby. Set to off FIRST when switching the shop to the standby
# (the guide, "Switch to the standby"), and back to on once the shop is back on this server.
STANDBY_SYNC=on

# --- Alerts (optional; an uptime monitor's "push" addresses) --------------------------------------
# Called after every good backup + standby copy, so a missing night is noticed.
BACKUP_PING_URL=
# Called when the backup or the standby copy fails (with the reason).
BACKUP_PING_FAIL_URL=

# --- Optional features (empty = off) ----------------------------------------------------------------
# Daily sales target: dashboard card, Settings section, daily report PDF.
FEATURE_SALES_TARGET=
# Email for "Forgot password?" (docs/operations/password-reset.md). Hidden until both are set.
RESEND_API_KEY=
EMAIL_FROM=

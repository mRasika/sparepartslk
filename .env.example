# Login sessions. 32+ random characters: openssl rand -hex 32. Same value on Vercel Preview and Production.
BETTER_AUTH_SECRET=
# Optional; set in Docker (the site's https address, no trailing slash).
BETTER_AUTH_URL=
# Pooled connection used by the app at runtime.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Direct (non-pooled) connection used for migrations.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/sparepartslk_test
# Optional features, off unless set to 1. Turn on only when the owner asks for one.
# Daily sales target: dashboard card, Settings section, daily report PDF.
FEATURE_SALES_TARGET=
# Email for "Forgot password?" (docs/operations/password-reset.md). Hidden until both are set.
RESEND_API_KEY=
EMAIL_FROM=
# Local only: write emails as files to this folder instead of sending them (ignored on Vercel Production).
EMAIL_OUTBOX_DIR=

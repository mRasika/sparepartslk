# Local values are printed by `pnpm supabase start` (or `pnpm supabase status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Pooled connection used by the app at runtime.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Direct (non-pooled) connection used for migrations.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/sparepartslk_test
